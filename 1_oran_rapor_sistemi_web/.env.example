# Veritabanı yapılandırması
POSTGRES_USER=admin
POSTGRES_PASSWORD=GuvenliBirSifreBelirleyin123
POSTGRES_DB=report_db

# Uygulama Veritabanı Bağlantı Cümlesi (Prisma için)
# Üstteki verilerle uyumlu olmalıdır. db kısmı docker-compose içindeki servis adıdır.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public

# Uygulamanın yayınlanacağı adres (Domain veya IP)
# Örnek: http://rapor.oran.local:3005
NEXTAUTH_URL=http://rapor.oran.local:3005

# Güvenli oturum yönetimi için gizli anahtar (Rastgele karmaşık bir metin oluşturun)
# Oluşturmak için terminalde: openssl rand -base64 32
NEXTAUTH_SECRET=Buraya_Rastgele_Karmasik_Bir_Sifre_Yazin_123456789
